<% content_for :title, "Pacientes" %>
<% content_for :subtitle, "#{pluralize(@patients.size, 'paciente cadastrado', plural: 'pacientes cadastrados')} · Unidade #{current_user.unit&.name || current_user.organization.name}" %>

<div class="grid gap-4 grid-cols-1 lg:grid-cols-[300px_1fr]">
  <div class="flex flex-col gap-2.5 col-span-full"><%= link_to "+ Novo paciente", new_patient_path, class: "btn btn-primary", style: "align-self:flex-start" %></div>
  <aside class="card p-2 overflow-y-auto max-h-[50vh] lg:max-h-[74vh]">
    <% @patients.each do |patient| %>
      <%= link_to patient_path(patient), class: "profile-list-item #{'is-active' if @patient == patient}" do %><span class="avatar"><%= patient.initials %></span><span class="min-w-0 flex-1"><strong class="block text-[.8438rem] truncate"><%= patient.name %></strong><small class="block text-[.6875rem]" style="color:var(--color-text-muted)"><%= patient.convenio %></small></span><% end %>
    <% end %>
  </aside>

  <% if @patient %>
    <div>
      <div class="card p-5 mb-3.5">
        <div class="flex justify-between items-start gap-3 flex-wrap"><div class="flex gap-3 items-center"><div class="profile-hero-avatar"><%= @patient.initials %></div><div><h2 class="text-[1.375rem] font-semibold"><%= @patient.name %></h2><p class="text-sm mt-1" style="color:var(--color-text-muted)"><%= [@patient.age && "#{@patient.age} anos", @patient.sex, @patient.convenio].compact.join(" · ") %></p></div></div><% if @patient.allergy.present? %><span class="chip chip-faltou">Alergia: <%= @patient.allergy %></span><% end %></div>
        <div class="profile-stat-grid mt-5 pt-4 border-t" style="border-color:var(--color-border)"><div><span>Consultas</span><strong><%= @appointments.size %></strong></div><div><span>Concluídas</span><strong><%= @appointments.count { |appointment| appointment.status == "concluido" } %></strong></div><div><span>Convênio</span><strong><%= @patient.convenio %></strong></div><div><span>Ficha clínica</span><strong><%= @patient.chart_present? ? "Preenchida" : "Pendente" %></strong></div></div>
      </div>

      <div class="profile-sections" data-controller="profile-sections" data-profile-sections-active-value="dados">
        <div class="encounter-section-tabs" role="tablist" aria-label="Seções do paciente">
          <% [["dados", "Dados", "prontuario"], ["ficha", "Ficha clínica", "editar"], ["consultas", "Consultas", "alteracoes"], ["alteracoes", "Alterações", "permissoes"]].each do |section, label, icon| %><button type="button" class="encounter-section-tab" role="tab" aria-selected="false" data-profile-sections-target="tab" data-section="<%= section %>" data-action="profile-sections#select"><span class="encounter-section-icon"><%= render "encounters/section_icon", name: icon %></span><span><%= label %></span></button><% end %>
        </div>

        <section class="encounter-section-panel" role="tabpanel" data-profile-sections-target="panel" data-section="dados"><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "encounters/section_icon", name: "prontuario" %></span><div><h3>Dados do paciente</h3><p>Informações cadastrais e de contato.</p></div></div><div class="info-list"><% [["CPF", @patient.cpf, "font-mono"], ["Nascimento", @patient.birth_date&.strftime("%d/%m/%Y"), "font-mono"], ["Telefone", @patient.phone, "font-mono"], ["E-mail", @patient.email, ""], ["Carteirinha", @patient.carteirinha, "font-mono"], ["Responsável", @patient.guardian_name, ""]].each do |label, value, klass| %><div class="info-row"><div class="info-label"><%= label %></div><div class="info-value <%= klass %>"><%= value.presence || "—" %></div></div><% end %><div class="info-row sm:col-span-2"><div class="info-label">Endereço</div><div class="info-value"><%= @patient.address.presence || "—" %></div></div></div></div></section>

        <section class="encounter-section-panel" role="tabpanel" data-profile-sections-target="panel" data-section="ficha" hidden><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "encounters/section_icon", name: "editar" %></span><div><h3>Ficha clínica</h3><p>Condições e informações importantes para o atendimento.</p></div></div><%= form_with model: @patient, url: patient_path(@patient), method: :patch, class: "flex flex-col gap-4" do |f| %><div class="grid grid-cols-1 sm:grid-cols-3 gap-3"><div class="field"><div class="f-label">Tipo sanguíneo</div><%= f.text_field :blood_type, class: "field-input", placeholder: "Ex: O+" %></div><div class="field"><div class="f-label">Contato de emergência</div><%= f.text_field :emergency_contact_name, class: "field-input" %></div><div class="field"><div class="f-label">Telefone de emergência</div><%= f.text_field :emergency_contact_phone, class: "field-input" %></div></div><div class="field"><div class="f-label">Condições crônicas</div><%= f.text_area :chronic_conditions, class: "field-input", style: "min-height:64px" %></div><div class="field"><div class="f-label">Medicações em uso contínuo</div><%= f.text_area :current_medications, class: "field-input", style: "min-height:64px" %></div><div class="field"><div class="f-label">Histórico familiar</div><%= f.text_area :family_history, class: "field-input", style: "min-height:64px" %></div><div data-controller="dynamic-fields"><div class="flex justify-between items-center mb-2"><span class="f-label">Campos personalizados</span><button type="button" class="btn" style="padding:5px 10px;font-size:.75rem" data-action="dynamic-fields#add">Adicionar campo</button></div><div data-dynamic-fields-target="list" class="flex flex-col gap-2"><% @patient.custom_fields_list.each_with_index do |field, i| %><div class="flex gap-2 items-end" data-dynamic-fields-target="row"><div class="field" style="flex:1"><div class="f-label">Campo</div><input name="patient[custom_fields][<%= i %>][label]" value="<%= field["label"] %>" class="field-input"></div><div class="field" style="flex:1.4"><div class="f-label">Valor</div><input name="patient[custom_fields][<%= i %>][value]" value="<%= field["value"] %>" class="field-input"></div><button type="button" class="btn btn-ghost btn-danger" data-action="dynamic-fields#remove">Remover</button></div><% end %></div><template data-dynamic-fields-target="template"><div class="flex gap-2 items-end" data-dynamic-fields-target="row"><div class="field" style="flex:1"><div class="f-label">Campo</div><input name="patient[custom_fields][__INDEX__][label]" class="field-input"></div><div class="field" style="flex:1.4"><div class="f-label">Valor</div><input name="patient[custom_fields][__INDEX__][value]" class="field-input"></div><button type="button" class="btn btn-ghost btn-danger" data-action="dynamic-fields#remove">Remover</button></div></template></div><%= f.submit "Salvar ficha clínica", class: "btn btn-primary" %><% end %></div></section>

        <section class="encounter-section-panel" role="tabpanel" data-profile-sections-target="panel" data-section="consultas" hidden><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "encounters/section_icon", name: "alteracoes" %></span><div><h3>Consultas</h3><p><%= pluralize(@appointments.size, "consulta registrada") %>.</p></div></div><% if @appointments.any? %><% @appointments.each do |appointment| %><%= link_to encounter_path(appointment), class: "document-row", style: "color:inherit" do %><div><strong><%= appointment.appointment_type %><%= " — #{appointment.encounter.diagnosis}" if appointment.encounter&.diagnosis.present? %></strong><p><%= l(appointment.starts_at, format: :short) %> · <%= appointment.professional.name %> · <%= appointment.unit.name %></p></div><span class="chip chip-<%= appointment.status %>"><%= appointment.status_label %></span><% end %><% end %><% else %><div class="section-empty"><p>Nenhuma consulta registrada.</p></div><% end %></div></section>

        <section class="encounter-section-panel" role="tabpanel" data-profile-sections-target="panel" data-section="alteracoes" hidden><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "encounters/section_icon", name: "permissoes" %></span><div><h3>Alterações</h3><p>Histórico auditável do cadastro do paciente.</p></div></div><%= render "shared/audit_trail", audits: @audits %></div></section>
      </div>
    </div>
  <% end %>
</div>
