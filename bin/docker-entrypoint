#!/bin/bash -e

if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  # Sobe o Tor como proxy SOCKS5 local (127.0.0.1:9050) antes do Rails, pra
  # nenhuma chamada à OpenRouter saia com o IP real do servidor — mesmo
  # mecanismo usado em desenvolvimento, ver app/services/open_router_client.rb.
  mkdir -p /rails/tmp/tor-data
  /usr/bin/tor -f /rails/config/tor/torrc > /rails/tmp/tor-data/tor.log 2>&1 &

  # A porta SOCKS abre antes do circuito estar pronto — precisa esperar o
  # bootstrap chegar a 100%, senão a primeira chamada à OpenRouter falha.
  for i in $(seq 1 60); do
    if grep -q "Bootstrapped 100%" /rails/tmp/tor-data/tor.log 2>/dev/null; then
      echo "Tor pronto (circuito estabelecido) em 127.0.0.1:9050"
      break
    fi
    sleep 1
  done

  # Sobe o WPPConnect-server (fala com o WhatsApp Web de verdade) no mesmo
  # container, por decisão do time — ver plano de IA/WhatsApp. Sem
  # WPPCONNECT_SECRET_KEY configurada, só pula essa parte: o resto do sistema
  # funciona normal, só a secretária de IA no WhatsApp fica indisponível
  # (Whatsapp::ConnectionsController já degrada bem pra esse caso).
  #
  # userData/tokens ficam em /rails/tmp por padrão — SEM disco persistente
  # do Render montado ali, a sessão do WhatsApp some a cada deploy/restart e
  # precisa escanear o QR de novo. Pra manter a sessão entre deploys, monte
  # um Persistent Disk do Render em WPPCONNECT_DATA_DIR.
  if [ -n "$WPPCONNECT_SECRET_KEY" ]; then
    data_dir="${WPPCONNECT_DATA_DIR:-/rails/tmp/wppconnect}"
    mkdir -p "$data_dir/userData"

    cat > "$data_dir/config.json" <<JSON
{
  "secretKey": "$WPPCONNECT_SECRET_KEY",
  "port": "21465",
  "startAllSession": false,
  "customUserDataDir": "$data_dir/userData/",
  "webhook": { "url": "http://localhost:${PORT:-3000}/whatsapp/webhook" },
  "createOptions": { "autoClose": 0 }
}
JSON

    # PORT=21465 explícito: o wppserver lê a env PORT e ignora "port" do
    # config.json quando ela existe (confirmado lendo o código-fonte) — sem
    # isso ele tentaria subir na mesma porta que o Rails/Puma usa (a env PORT
    # do Render), derrubando os dois.
    #
    # >(...) + tee: manda o log tanto pro arquivo quanto pro stdout do
    # container, prefixado, senão some — o painel do Render só mostra o
    # stdout do processo principal, e sem isso um erro do wppserver/Chromium
    # fica invisível (só dá pra ver entrando via Shell no container).
    #
    # (cd "$data_dir" && ...) num subshell: o wppconnect-server sempre cria
    # ./WhatsAppImages e ./uploads relativos ao diretório de trabalho no
    # boot, sem opção de configurar isso — rodando com cwd em /rails, quebra
    # com EACCES em produção (a raiz do app é só-leitura, só /rails/tmp e
    # afins são graváveis; confirmado em teste real no Render). O subshell
    # isola o cd pra não afetar o resto deste script (o db:prepare mais
    # abaixo depende do cwd continuar em /rails).
    (cd "$data_dir" && PORT=21465 wppserver --config "$data_dir/config.json") \
      > >(tee "$data_dir/wppserver.log" | sed 's/^/[wppserver] /') 2>&1 &

    wpp_ready=0
    for i in $(seq 1 30); do
      if curl -sf "http://localhost:21465/api-docs" > /dev/null 2>&1; then
        echo "WPPConnect-server pronto em 127.0.0.1:21465"
        wpp_ready=1
        break
      fi
      sleep 1
    done
    if [ "$wpp_ready" -eq 0 ]; then
      echo "WPPConnect-server NÃO respondeu em 30s — seguindo sem ele. Últimas linhas do log:"
      tail -n 40 "$data_dir/wppserver.log" 2>/dev/null | sed 's/^/[wppserver] /'
    fi
  else
    echo "WPPCONNECT_SECRET_KEY não configurada — secretária de IA no WhatsApp desativada nessa instância."
  fi

  ./bin/rails db:prepare
fi

exec "${@}"
