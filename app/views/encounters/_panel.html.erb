<% if @appointment %>
  <% patient = @appointment.patient %>
  <% encounter = @appointment.encounter %>
  <% locked = @appointment.status == "concluido" %>

  <div id="appointment-details" class="card p-4 mb-3.5" data-controller="encounter-mobile-focus" data-encounter-mobile-focus-target-value="true">
    <div class="flex justify-between items-start flex-wrap gap-2.5">
      <div><h2 class="text-[1.1875rem] font-semibold"><%= link_to patient.name, patient_path(patient), style: "color:inherit;", data: { turbo_frame: "_top" } %></h2><div class="flex gap-2 flex-wrap mt-1.5"><span class="chip chip-neutral"><%= patient.age %> anos</span><span class="chip chip-neutral"><%= patient.convenio %><%= patient.carteirinha.present? ? " · carteirinha #{patient.carteirinha}" : "" %></span><% if patient.guardian_name.present? %><span class="chip chip-neutral">Resp.: <%= patient.guardian_name %></span><% end %><% if patient.allergy.present? %><span class="chip chip-faltou">Alergia: <%= patient.allergy %></span><% end %></div></div>
      <span class="chip chip-<%= @appointment.status %>" style="font-size:.75rem;padding:5px 10px"><%= @appointment.status_label %></span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-4 pt-4 border-t text-sm" style="border-color:var(--color-border)"><div><div class="f-label">Data e horário</div><div class="font-mono"><%= @appointment.starts_at.strftime("%d/%m/%Y %H:%M") %>–<%= @appointment.ends_at.strftime("%H:%M") %></div></div><div><div class="f-label">Tipo</div><div><%= @appointment.appointment_type %></div></div><div><div class="f-label">Profissional</div><div><%= @appointment.professional.name %> · <span style="color:var(--color-text-muted)"><%= @appointment.professional.crm %></span></div></div><div><div class="f-label">Unidade</div><div><%= @appointment.unit.name %></div></div></div>
    <div class="flex gap-2 flex-wrap mt-4 pt-4 border-t" style="border-color:var(--color-border)"><% if @appointment.can_confirm? %><%= button_to "Confirmar", confirm_encounter_path(@appointment), method: :patch, class: "btn btn-primary", form: { data: { turbo_confirm: "Confirmar esta consulta?" } } %><% end %><% if @appointment.can_start? %><%= button_to "Iniciar atendimento", start_encounter_path(@appointment), method: :patch, class: "btn btn-primary", form: { data: { turbo_confirm: "Iniciar o atendimento agora?" } } %><% end %><% if @appointment.can_finish? %><%= button_to "Finalizar atendimento", finish_encounter_path(@appointment), method: :patch, class: "btn btn-primary", form: { data: { turbo_confirm: "Finalizar este atendimento? O prontuário será travado para edição." } } %><% end %><% if @appointment.can_reopen? %><%= button_to "Reabrir atendimento", reopen_encounter_path(@appointment), method: :patch, class: "btn" %><% end %><% if @appointment.can_schedule_follow_up? %><%= button_to "Agendar retorno em 7 dias", schedule_follow_up_encounter_path(@appointment), method: :post, class: "btn" %><% end %><% if @appointment.can_mark_no_show? %><%= button_to "Marcar falta", no_show_encounter_path(@appointment), method: :patch, class: "btn btn-ghost" %><% end %><% if @appointment.can_cancel? %><%= button_to "Cancelar consulta", cancel_encounter_path(@appointment), method: :patch, class: "btn btn-ghost btn-danger" %><% end %></div>
  </div>

  <div class="encounter-sections" data-controller="encounter-sections" data-encounter-sections-active-value="prontuario">
    <div class="encounter-section-tabs" role="tablist" aria-label="Seções do atendimento"><% [["prontuario", "Prontuário"], ["receitas", "Receitas"], ["permissoes", "Permissões"], ["alteracoes", "Alterações"], ["documentos", "Documentos"], ["editar", "Editar consulta"]].each do |section, label| %><button type="button" class="encounter-section-tab" role="tab" aria-selected="false" data-encounter-sections-target="tab" data-section="<%= section %>" data-action="encounter-sections#select"><span class="encounter-section-icon"><%= render "section_icon", name: section %></span><span><%= label %></span></button><% end %></div>

    <section class="encounter-section-panel" role="tabpanel" data-encounter-sections-target="panel" data-section="prontuario">
      <% if @appointment.status == "faltou" %><div class="section-notice is-warning">Paciente não compareceu ao horário agendado.</div><% elsif @appointment.status == "cancelado" %><div class="section-notice">Esta consulta foi cancelada.</div><% elsif !@appointment.started? %><div class="section-empty"><span class="encounter-section-icon"><%= render "section_icon", name: "prontuario" %></span><p>O prontuário ficará disponível quando o atendimento for iniciado.</p></div><% end %>
      <% if encounter %><%= form_with model: encounter, url: encounter_path(@appointment, **filter_params), method: :patch do |f| %><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "section_icon", name: "prontuario" %></span><div><h3>Prontuário clínico</h3><p>Registre a evolução do atendimento.</p></div></div><div class="field"><div class="f-label">Queixa principal</div><%= f.text_field :chief_complaint, class: "field-input", disabled: locked, placeholder: "O que trouxe o paciente à consulta" %></div><div class="section-divider"></div><div class="f-label mb-2">Sinais vitais</div><div class="vitals-grid"><div class="field"><div class="f-label">PA (mmHg)</div><%= f.text_field :blood_pressure, class: "field-input", disabled: locked %></div><div class="field"><div class="f-label">FC (bpm)</div><%= f.number_field :heart_rate, class: "field-input", disabled: locked %></div><div class="field"><div class="f-label">Temp (°C)</div><%= f.text_field :temperature, class: "field-input", disabled: locked %></div><div class="field"><div class="f-label">Peso (kg)</div><%= f.text_field :weight_kg, class: "field-input", disabled: locked %></div><div class="field"><div class="f-label">Altura (cm)</div><%= f.text_field :height_cm, class: "field-input", disabled: locked %></div></div><% { subjective: "Subjetivo", objective: "Objetivo", assessment: "Avaliação", diagnosis: "Diagnóstico", plan: "Plano" }.each do |field, label| %><div class="field mt-4"><div class="f-label"><%= label %></div><%= field == :diagnosis ? f.text_field(field, class: "field-input", disabled: locked) : f.text_area(field, class: "field-input", style: "min-height:72px;resize:vertical", disabled: locked) %></div><% end %><div class="section-divider"></div><div data-controller="dynamic-fields"><div class="flex items-center justify-between mb-2"><div class="f-label">Campos personalizados</div><% unless locked %><button type="button" class="btn" style="padding:5px 10px;font-size:.75rem" data-action="dynamic-fields#add">Adicionar campo</button><% end %></div><p class="text-xs <%= "hidden" if encounter.custom_fields_list.any? %>" style="color:var(--color-text-muted)" data-dynamic-fields-target="empty">Nenhum campo personalizado.</p><div class="flex flex-col gap-2" data-dynamic-fields-target="list"><% encounter.custom_fields_list.each_with_index do |custom, i| %><div class="flex gap-2 items-end" data-dynamic-fields-target="row"><div class="field" style="flex:1"><div class="f-label">Campo</div><input type="text" name="encounter[custom_fields][<%= i %>][label]" value="<%= custom["label"] %>" class="field-input" <%= "disabled" if locked %>></div><div class="field" style="flex:1.4"><div class="f-label">Valor</div><input type="text" name="encounter[custom_fields][<%= i %>][value]" value="<%= custom["value"] %>" class="field-input" <%= "disabled" if locked %>></div><% unless locked %><button type="button" class="btn btn-ghost btn-danger" data-action="dynamic-fields#remove">Remover</button><% end %></div><% end %></div><% unless locked %><template data-dynamic-fields-target="template"><div class="flex gap-2 items-end" data-dynamic-fields-target="row"><div class="field" style="flex:1"><div class="f-label">Campo</div><input type="text" name="encounter[custom_fields][__INDEX__][label]" class="field-input"></div><div class="field" style="flex:1.4"><div class="f-label">Valor</div><input type="text" name="encounter[custom_fields][__INDEX__][value]" class="field-input"></div><button type="button" class="btn btn-ghost btn-danger" data-action="dynamic-fields#remove">Remover</button></div></template><% end %></div><% unless locked %><%= f.submit "Salvar prontuário", class: "btn btn-primary mt-5" %><% end %></div><% end %><% end %>
    </section>

    <section class="encounter-section-panel" role="tabpanel" data-encounter-sections-target="panel" data-section="receitas" hidden><% if encounter %><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "section_icon", name: "receitas" %></span><div><h3>Receitas</h3><p><%= pluralize(encounter.prescriptions.size, "receita") %> emitida(s) neste atendimento.</p></div></div><% encounter.prescriptions.order(issued_at: :desc).each do |rx| %><div class="document-row"><div><strong>Receita de <%= rx.issued_at.strftime("%d/%m/%Y %H:%M") %></strong><p><%= rx.prescription_items.map(&:medication_name).join(", ") %></p></div><%= link_to "Imprimir PDF", print_prescription_path(rx), target: "_blank", class: "btn" %></div><% end %><% unless locked %><details class="mt-4" <%= "open" unless encounter.prescriptions.any? %>><summary class="font-semibold text-sm cursor-pointer" style="color:var(--color-accent)">Emitir nova receita</summary><%= form_with model: Prescription.new, url: prescriptions_path(@appointment), method: :post, class: "mt-3" do |f| %><% 3.times do %><div class="rx-item-row"><%= f.fields_for :prescription_items, PrescriptionItem.new do |i| %><div class="field"><div class="f-label">Medicamento</div><%= i.text_field :medication_name, class: "field-input" %></div><div class="field"><div class="f-label">Dosagem</div><%= i.text_field :dosage, class: "field-input" %></div><div class="field"><div class="f-label">Frequência</div><%= i.text_field :frequency, class: "field-input" %></div><div class="field"><div class="f-label">Duração</div><%= i.text_field :duration, class: "field-input" %></div><% end %></div><% end %><div class="field mt-3"><div class="f-label">Observações</div><%= f.text_area :notes, class: "field-input", style: "min-height:56px" %></div><%= f.submit "Emitir receita", class: "btn btn-primary mt-3" %><% end %></details><% end %></div><% else %><div class="section-empty"><span class="encounter-section-icon"><%= render "section_icon", name: "receitas" %></span><p>Inicie o atendimento para emitir uma receita.</p></div><% end %></section>

    <section class="encounter-section-panel" role="tabpanel" data-encounter-sections-target="panel" data-section="permissoes" hidden><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "section_icon", name: "permissoes" %></span><div><h3>Permissões de acesso</h3><p>Controle quem pode consultar este atendimento.</p></div></div><% if @appointment.permissions_manageable_by?(current_user) %><% if @appointment.appointment_permissions.any? %><% @appointment.appointment_permissions.includes(:user, :granted_by).each do |grant| %><div class="document-row"><div><strong><%= grant.user.name %></strong><p><%= grant.user.display_role %> · liberado por <%= grant.granted_by.name %></p></div><%= button_to "Remover", appointment_permission_path(@appointment, grant), method: :delete, class: "btn btn-ghost btn-danger", form: { data: { turbo_confirm: "Remover o acesso de #{grant.user.name}?" } } %></div><% end %><% else %><p class="text-sm" style="color:var(--color-text-muted)">Somente os responsáveis padrão têm acesso a esta consulta.</p><% end %><% granted_ids = @appointment.permitted_users.pluck(:id); excluded_ids = ([@appointment.professional.user&.id] + granted_ids).compact; eligible = current_user.organization.users.where(role: %w[medico secretaria]).where.not(id: excluded_ids).order(:name) %><% if eligible.any? %><%= form_with url: appointment_permissions_path(@appointment), method: :post, class: "flex gap-2 items-end flex-wrap mt-4" do %><div class="field" style="min-width:220px"><div class="f-label">Liberar acesso para</div><select name="user_id" class="field-select"><% eligible.each do |u| %><option value="<%= u.id %>"><%= u.name %> — <%= u.display_role %></option><% end %></select></div><button type="submit" class="btn btn-primary">Adicionar</button><% end %><% end %><% else %><div class="section-empty"><p>Você pode visualizar este atendimento, mas não tem permissão para alterar os acessos.</p></div><% end %></div></section>

    <section class="encounter-section-panel" role="tabpanel" data-encounter-sections-target="panel" data-section="alteracoes" hidden><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "section_icon", name: "alteracoes" %></span><div><h3>Alterações</h3><p>Histórico auditável de tudo que mudou.</p></div></div><%= render "shared/audit_trail", audits: @appointment.own_and_associated_audits %></div></section>
    <section class="encounter-section-panel" role="tabpanel" data-encounter-sections-target="panel" data-section="documentos" hidden><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "section_icon", name: "documentos" %></span><div><h3>Documentos</h3><p>Arquivos disponíveis para impressão.</p></div></div><% if encounter %><div class="document-row"><div><strong>Prontuário clínico</strong><p>Consulta de <%= l(@appointment.starts_at.to_date) %></p></div><%= link_to "Abrir PDF", print_encounter_path(@appointment), target: "_blank", class: "btn btn-primary" %></div><% encounter.prescriptions.order(issued_at: :desc).each do |rx| %><div class="document-row"><div><strong>Receita médica</strong><p>Emitida em <%= l(rx.issued_at, format: :short) %></p></div><%= link_to "Abrir PDF", print_prescription_path(rx), target: "_blank", class: "btn" %></div><% end %><% else %><div class="section-empty"><p>Os documentos ficarão disponíveis após o início do atendimento.</p></div><% end %></div></section>
    <section class="encounter-section-panel" role="tabpanel" data-encounter-sections-target="panel" data-section="editar" hidden><div class="section-card"><div class="section-card-heading"><span class="encounter-section-icon"><%= render "section_icon", name: "editar" %></span><div><h3>Editar consulta</h3><p>Altere horário, profissional ou tipo antes do atendimento começar.</p></div></div><% if current_user.full_access? && @appointment.can_reschedule? %><%= form_with url: update_encounter_appointment_path(@appointment), method: :patch do %><div class="edit-appointment-grid"><div class="field"><div class="f-label">Data e horário</div><%= datetime_local_field_tag "appointment[starts_at]", @appointment.starts_at.strftime("%Y-%m-%dT%H:%M"), class: "field-input", required: true %></div><div class="field"><div class="f-label">Profissional</div><%= select_tag "appointment[professional_id]", options_from_collection_for_select(@professionals, :id, :name, @appointment.professional_id), class: "field-select" %></div><div class="field"><div class="f-label">Tipo</div><%= select_tag "appointment[appointment_type]", options_for_select(Appointment::TYPES, @appointment.appointment_type), class: "field-select" %></div></div><%= submit_tag "Salvar alterações", class: "btn btn-primary mt-5" %><% end %><% elsif !@appointment.can_reschedule? %><div class="section-empty"><p>Não é possível editar uma consulta que já foi iniciada, finalizada, cancelada ou marcada como falta.</p></div><% else %><div class="section-empty"><p>Apenas administradores e a secretaria podem editar esta consulta.</p></div><% end %></div></section>
  </div>
<% end %>
